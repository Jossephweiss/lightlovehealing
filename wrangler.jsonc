{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lightlovehealing",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "routes": [
    { "pattern": "lightlovehealing.org", "custom_domain": true },
    { "pattern": "www.lightlovehealing.org", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lightlovehealing",
      "database_id": "e2b5010e-2ee7-4a43-9823-d5dea9c44c88",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    { "name": "NOTIFY", "destination_address": "jw.gandr@gmail.com" }
  ],
  "observability": { "enabled": true }
}
